{
  "name": "armory",
  "version": "0.1.0",
  "private": true,
  "description": "A Node.js crypto-wallet signing daemon for development and testing — holds a BIP-39 mnemonic behind a Unix-socket IPC protocol of its own design and signs EVM/Hyperliquid artifacts under a hardcoded destination policy. A software stand-in for a planned dedicated-hardware signer. Not an HSM.",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://github.com/snowkidind/armulator-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snowkidind/armulator-js.git"
  },
  "bugs": {
    "url": "https://github.com/snowkidind/armulator-js/issues"
  },
  "keywords": [
    "signing-daemon",
    "bip39",
    "bip32",
    "secp256k1",
    "signing",
    "development"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "init": "tsx src/index.ts init",
    "rekey": "tsx src/index.ts rekey",
    "cli": "tsx cli/index.ts",
    "example": "tsx examples/reference-client.ts"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "argon2": "^0.44.0",
    "bech32": "^2.0.0",
    "dotenv": "^16.4.0",
    "ethers": "^6.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0"
  }
}
