{
  "compilerOptions": {
    "target":                        "ES2022",
    "module":                        "ESNext",
    "moduleResolution":              "node",
    "esModuleInterop":               true,
    "allowSyntheticDefaultImports":  true,
    "strict":                        true,
    "outDir":                        "dist",
    "rootDir":                       ".",
    "declaration":                   true,
    "sourceMap":                     true,
    "skipLibCheck":                  true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule":             true
  },
  "include": ["src/**/*", "cli/**/*"],
  "ts-node": {
    "esm":                              true,
    "experimentalSpecifierResolution":  "node"
  }
}
