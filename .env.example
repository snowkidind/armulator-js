# Required — generated by `npm run init`. Never set manually.
ARMORY_KEY=

# Optional — socket path (default: /tmp/armory.sock)
# ARMORY_SOCKET_PATH=/tmp/armory.sock

# Optional — log verbosity: debug | info | none  (default: info)
# ARMORY_LOG_LEVEL=info

# Dev only — import a known BIP-39 phrase instead of generating one.
# Ignored if .keys/mnemonic.enc already exists.
# NEVER set this in production.
# ARMORY_MNEMONIC=
