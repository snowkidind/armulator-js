# Copy to .env and fill in. `npm run init` writes ARMORY_KEY here for you.

# ── Required ──────────────────────────────────────────────────────────────────

# Encryption key for the mnemonic at rest. Generated by `npm run init`.
# Never set this manually.
ARMORY_KEY=

# External withdrawal address, appended to the whitelist defaults in
# src/policy.ts. REQUIRED BY DESIGN: armory refuses to start until you declare
# at least one external withdrawal address — src/policy.ts will not load without
# it, so both the daemon and `npm run init` fail until it is set. This forces an
# explicit choice of where funds may be withdrawn. For emulator/dev use any valid
# EVM address works; for real use, set your actual withdrawal address. The daemon
# validates its format at startup.
EXTERNAL_WHITELIST_ADDRESS_01=0x0000000000000000000000000000000000000000

# ── Optional ──────────────────────────────────────────────────────────────────

# Unix socket path (default: /tmp/armory.sock)
# ARMORY_SOCKET_PATH=/tmp/armory.sock

# Log verbosity: debug | info | none  (default: info)
# ARMORY_LOG_LEVEL=info

# Number of HD indices to pre-derive into the internal pool (default: 125)
# ARMORY_POOL_SIZE=125

# Directory holding mnemonic.enc (default: .keys/ next to the package root)
# ARMORY_KEYS_DIR=.keys

# Path to the .env file that init/rekey write to (default: .env next to the package root)
# ARMORY_ENV_PATH=.env

# ── Dev / test only — NEVER set in production ───────────────────────────────────

# Import a known BIP-39 phrase instead of generating one.
# Used by `init`, or by the daemon when .keys/mnemonic.enc does not yet exist.
# ARMORY_MNEMONIC=

# Override the external whitelist (comma-separated). Overrides policy.ts defaults.
# ARMORY_EXTERNAL_WHITELIST=0xabc...,cosmos1...

# Override the drain/emergency recovery address (single EVM address).
# ARMORY_DRAIN_ADDRESS=0xabc...

# Skip .env loading entirely. Used by the test harness so .env can't taint runs.
# ARMORY_NO_DOTENV=1
